{
  "versao": 2,
  "secao": "hero",
  "type": "object",
  "required": ["titulo", "subtitulo", "cta"],
  "properties": {
    "titulo": { "type": "string", "minLength": 1 },
    "subtitulo": { "type": "string", "minLength": 1 },
    "cta": {
      "type": "object",
      "required": ["texto", "url"],
      "properties": {
        "texto": { "type": "string", "minLength": 1 },
        "url": { "type": "string", "minLength": 1, "format": "url" }
      }
    },
    "imagem": {
      "type": "object",
      "required": ["src", "alt"],
      "properties": {
        "src": { "type": "string", "minLength": 1 },
        "alt": { "type": "string", "minLength": 1 }
      }
    }
  }
}
